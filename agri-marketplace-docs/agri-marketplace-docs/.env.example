# Copy to .env and fill in real values. NEVER commit .env or real secrets.

# App
APP_ENV=development
SECRET_KEY=
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agri_market

# Payments (test mode only for the prototype)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Routing
OSRM_BASE_URL=

# Weather (Open-Meteo needs no key; set if using IMD or another provider)
WEATHER_API_KEY=

# Language / voice (optional upgrade path)
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# File storage for listing photos
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
